{
  "name": "chrome-cdp-kit",
  "version": "1.2.0",
  "description": "Chrome DevTools Protocol CLI: drive the live browser and transfer login state into an independent profile (built on chrome-cdp-skill).",
  "type": "module",
  "bin": {
    "cdp": "./skills/chrome-cdp/scripts/cdp.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node --check skills/chrome-cdp/scripts/cdp.mjs && node --test test/*.test.mjs"
  },
  "files": [
    "skills/",
    "docs/",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "pi": {
    "skills": [
      "./skills"
    ]
  },
  "keywords": [
    "pi-package",
    "skills",
    "chrome",
    "cdp",
    "browser",
    "devtools",
    "cookies",
    "localstorage",
    "agent",
    "edge"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yidasanqian/chrome-cdp-kit"
  }
}